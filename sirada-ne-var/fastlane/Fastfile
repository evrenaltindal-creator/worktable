# Sirada Ne Var?: App Store ve TestFlight isleri
#
# GitHub Actions'ta calisir (.github/workflows/sirada-ne-var-ios.yml). Gizli bilgiler
# GitHub secret'larindan gelir (depodaki diger uygulamalarla ortak); hicbiri depoda durmaz:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8      App Store Connect API anahtari
#   APPLE_TEAM_ID                              Apple Developer ekip kimligi
#   IOS_DISTRIBUTION_P12, IOS_P12_PASSWORD     Dagitim sertifikasi (base64 .p12) ve sifresi
#
# Isler:
#   status    Paket kimligi ve uygulama kaydi var mi, son derleme numarasi kac
#   register  Paket kimligini (Bundle ID) Apple hesabina kaydeder
#   build     Derler, dagitim sertifikasiyla imzalar, App Store Connect'e (TestFlight) yukler
#   testers   TestFlight ic test grubunu kurar ve App Store Connect kullanicilarini ekler
#   metadata  7 dilde magaza metinlerini ve ekran goruntulerini yukler

require 'json'
require 'fileutils'
require 'base64'
require 'openssl'

default_platform(:ios)

APP_DIR = File.expand_path('..', __dir__)
STORE   = File.join(APP_DIR, 'store')
LOCALE_TO_LANG = {
  'tr' => 'tr', 'en-US' => 'en', 'pt-BR' => 'pt', 'de-DE' => 'de',
  'fr-FR' => 'fr', 'ja' => 'ja', 'ko' => 'ko'
}.freeze

def settings
  JSON.parse(File.read(File.join(STORE, 'ayarlar.json')))
end

def app_id
  JSON.parse(File.read(File.join(APP_DIR, 'capacitor.config.json')))['appId']
end

def version
  JSON.parse(File.read(File.join(APP_DIR, 'package.json')))['version']
end

def need_env(*names)
  missing = names.select { |k| ENV[k].to_s.strip.empty? }
  UI.user_error!("GitHub secret eksik: #{missing.join(', ')}") unless missing.empty?
end

def api_key
  need_env('ASC_KEY_ID', 'ASC_ISSUER_ID', 'ASC_KEY_P8')
  app_store_connect_api_key(
    key_id: ENV['ASC_KEY_ID'].strip,
    issuer_id: ENV['ASC_ISSUER_ID'].strip,
    key_content: ENV['ASC_KEY_P8'],
    duration: 1200,
    in_house: false
  )
end

def find_app!
  app = Spaceship::ConnectAPI::App.find(app_id)
  return app if app
  UI.user_error!("App Store Connect'te #{app_id} icin uygulama kaydi yok. " \
                 "appstoreconnect.apple.com > Apps > + > New App ile olustur (sirada-ne-var/YAYINLAMA.md).")
end

# .p12 icindeki sertifikanin App Store Connect'teki karsiligini seri numarasindan bulur
def distribution_certificate
  need_env('IOS_DISTRIBUTION_P12', 'IOS_P12_PASSWORD')
  p12 = OpenSSL::PKCS12.new(Base64.decode64(ENV['IOS_DISTRIBUTION_P12']), ENV['IOS_P12_PASSWORD'])
  serial = p12.certificate.serial.to_s(16).upcase.sub(/\A0+/, '')
  certs = %w[DISTRIBUTION IOS_DISTRIBUTION].flat_map do |type|
    Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: type })
  end
  cert = certs.find { |c| c.serial_number.to_s.upcase.sub(/\A0+/, '') == serial }
  UI.user_error!("Dagitim sertifikasi (seri #{serial}) Apple hesabinda bulunamadi ya da suresi dolmus.") unless cert
  UI.message("Dagitim sertifikasi: #{cert.name} (son kullanma #{cert.expiration_date})")
  cert
end

# Bu uygulama icin App Store imzalama profilini bulur, yoksa olusturur ve kurar; UUID dondurur
def app_store_profile(cert)
  bundle = Spaceship::ConnectAPI::BundleId.find(app_id)
  UI.user_error!("Paket kimligi #{app_id} kayitli degil. Once 'register' isini calistir.") unless bundle
  profiles = Spaceship::ConnectAPI::Profile.all(filter: { profileType: 'IOS_APP_STORE', profileState: 'ACTIVE' },
                                                includes: 'bundleId,certificates')
  profile = profiles.find do |p|
    p.bundle_id && p.bundle_id.identifier == app_id && (p.certificates || []).any? { |c| c.id == cert.id }
  end
  if profile
    UI.message("Imzalama profili bulundu: #{profile.name}")
  else
    name = "Sirada Ne Var App Store #{Time.now.utc.strftime('%Y%m%d%H%M')}"
    profile = Spaceship::ConnectAPI::Profile.create(name: name, profile_type: 'IOS_APP_STORE',
                                                    bundle_id_id: bundle.id, certificate_ids: [cert.id])
    UI.success("Imzalama profili olusturuldu: #{name}")
  end
  dir = File.expand_path('~/Library/MobileDevice/Provisioning Profiles')
  FileUtils.mkdir_p(dir)
  File.binwrite(File.join(dir, "#{profile.uuid}.mobileprovision"), Base64.decode64(profile.profile_content))
  profile.uuid
end

def review_info
  keys = { first_name: 'REVIEW_FIRST_NAME', last_name: 'REVIEW_LAST_NAME', phone_number: 'REVIEW_PHONE', email_address: 'REVIEW_EMAIL' }
  vals = keys.transform_values { |k| ENV[k].to_s.strip }
  return nil if vals.values.any?(&:empty?)
  vals.merge(demo_user: '', demo_password: '',
             notes: 'Offline decision wheel and slot-style picker. Users type their own options and spin; ' \
                    'there is no betting, no coins, no prizes, no real-money gambling, no ads, no in-app purchases ' \
                    'and no data collection. No account or login needed. 7 languages (menu at top right).')
end

# App Store Connect API'ye dogrudan istek (fastlane'in token'i ile)
def asc_request(method, path, body = nil)
  require 'net/http'
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  req = { get: Net::HTTP::Get, patch: Net::HTTP::Patch, post: Net::HTTP::Post }.fetch(method).new(uri)
  req['Authorization'] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  req['Content-Type'] = 'application/json'
  req.body = JSON.generate(body) if body
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
  [res.code.to_i, res.body.to_s.empty? ? {} : JSON.parse(res.body)]
end

REVIEW_NOTES = 'Offline decision wheel and slot-style picker. Users type their own options and spin; ' \
               'there is no betting, no coins, no prizes, no real-money gambling, no ads, no in-app purchases ' \
               'and no data collection. No account or login needed. 7 languages (menu at top right).'

# Ilk surumde "App Review" kaydi hic yoksa deliver "No data" hatasiyla durur (fastlane #20538).
# Kaydi bastan olusturur: ad ve e-posta store/ayarlar.json'dan, telefon REVIEW_PHONE secret'indan (yoksa bos).
def ensure_review_detail(app)
  code, versions = asc_request(:get, "/v1/apps/#{app.id}/appStoreVersions?filter[platform]=IOS&limit=10")
  UI.user_error!("Surumler okunamadi (#{code})") unless code == 200
  editable = %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED INVALID_BINARY]
  v = versions['data'].find { |x| editable.include?(x.dig('attributes', 'appStoreState') || x.dig('attributes', 'appVersionState')) } ||
      versions['data'].first
  UI.user_error!('Duzenlenebilir surum yok') unless v
  code, detail = asc_request(:get, "/v1/appStoreVersions/#{v['id']}/appStoreReviewDetail")
  if code == 200 && detail['data']
    UI.message('App Review kaydi zaten var')
    return
  end
  s = settings['review'] || {}
  attrs = { contactFirstName: s['first_name'], contactLastName: s['last_name'], contactEmail: s['email'],
            contactPhone: ENV['REVIEW_PHONE'].to_s.strip, demoAccountRequired: false, notes: REVIEW_NOTES }
  attrs.reject! { |_, val| val.nil? || val == '' }
  code, res = asc_request(:post, '/v1/appStoreReviewDetails',
                          { data: { type: 'appStoreReviewDetails', attributes: attrs,
                                    relationships: { appStoreVersion: { data: { type: 'appStoreVersions', id: v['id'] } } } } })
  if code == 201
    UI.success("App Review kaydi olusturuldu (#{attrs.keys.join(', ')})")
  else
    UI.user_error!("App Review kaydi olusturulamadi (#{code}): #{res.to_json[0, 600]}")
  end
end

# Yas derecelendirmesi: hicbir hassas icerik yok. Slot makinesi gorunumu nedeniyle
# "simulated gambling" hafif/seyrek isaretlenir (bahis, jeton, odul yok).
AGE_BOOLEANS = %w[gambling unrestrictedWebAccess seventeenPlus advertising ageAssurance
                  healthOrWellnessTopics lootBox messagingAndChat parentalControls userGeneratedContent].freeze
AGE_SKIP = %w[kidsAgeBand ageRatingOverride ageRatingOverrideV2 koreaAgeRatingOverride
              developerAgeRatingInfoUrl gamblingAndContests].freeze

def set_age_rating(app)
  code, infos = asc_request(:get, "/v1/apps/#{app.id}/appInfos")
  UI.user_error!("appInfos okunamadi (#{code})") unless code == 200
  info = infos['data'].find { |i| !%w[READY_FOR_DISTRIBUTION READY_FOR_SALE].include?(i.dig('attributes', 'state') || i.dig('attributes', 'appStoreState')) } || infos['data'].first
  code, decl = asc_request(:get, "/v1/appInfos/#{info['id']}/ageRatingDeclaration")
  UI.user_error!("Yas derecelendirmesi okunamadi (#{code})") unless code == 200
  current = decl.dig('data', 'attributes') || {}
  attrs = {}
  current.each do |key, value|
    next if AGE_SKIP.include?(key)
    attrs[key] = if AGE_BOOLEANS.include?(key) || value == true || value == false
                   false
                 elsif key == 'gamblingSimulated'
                   'INFREQUENT_OR_MILD'
                 else
                   'NONE'
                 end
  end
  code, res = asc_request(:patch, "/v1/ageRatingDeclarations/#{decl.dig('data', 'id')}",
                          { data: { type: 'ageRatingDeclarations', id: decl.dig('data', 'id'), attributes: attrs } })
  if code == 200
    UI.success("Yas derecelendirmesi dolduruldu (#{attrs.size} soru)")
  else
    UI.important("Yas derecelendirmesi kaydedilemedi (#{code}): #{res.to_json[0, 600]}")
  end
end

platform :ios do
  desc 'Paket kimligi ve uygulama kaydinin durumunu yazar'
  lane :status do
    api_key
    id = app_id
    UI.message("Paket kimligi #{id}: #{Spaceship::ConnectAPI::BundleId.find(id) ? 'kayitli' : 'kayitli degil (register isi)'}")
    app = Spaceship::ConnectAPI::App.find(id)
    if app
      UI.success("Uygulama kaydi var: #{app.name} (Apple ID #{app.id}, ana dil #{app.primary_locale})")
      begin
        UI.message("TestFlight'taki son derleme: #{latest_testflight_build_number(app_identifier: id)}")
      rescue StandardError => e
        UI.message("Henuz derleme yok (#{e.message})")
      end
      groups = app.get_beta_groups.map(&:name)
      UI.message("TestFlight gruplari: #{groups.empty? ? 'yok' : groups.join(', ')}")
    else
      UI.important("App Store Connect'te #{id} icin uygulama kaydi yok. Web arayuzunden olusturulmali (Apps > + > New App).")
    end
  end

  desc 'Paket kimligini (Bundle ID) Apple hesabina kaydeder'
  lane :register do
    api_key
    id = app_id
    if Spaceship::ConnectAPI::BundleId.find(id)
      UI.success("Paket kimligi zaten kayitli: #{id}")
    else
      Spaceship::ConnectAPI::BundleId.create(name: 'Sirada Ne Var', platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS, identifier: id)
      UI.success("Paket kimligi kaydedildi: #{id}")
    end
    status
  end

  desc 'Derler, dagitim sertifikasiyla imzalar ve App Store Connect\'e (TestFlight) yukler'
  lane :build do
    api_key
    need_env('APPLE_TEAM_ID')
    id = app_id
    app = Spaceship::ConnectAPI::App.find(id)
    UI.important("App Store Connect'te #{id} icin uygulama kaydi yok: derleyip dogrulayacagim ama yuklemeyecegim.") unless app
    latest = begin
      latest_testflight_build_number(app_identifier: id, initial_build_number: 0)
    rescue StandardError => e
      UI.important("Son derleme numarasi okunamadi (#{e.message}); 1 ile basliyorum.")
      0
    end
    build_number = latest.to_i + 1
    uuid = app_store_profile(distribution_certificate)
    UI.message("Surum #{version}, derleme #{build_number}, profil #{uuid}")
    sh(File.join(APP_DIR, 'scripts', 'ios-build.sh'), id, version, build_number.to_s, uuid, app ? 'upload' : 'no-upload')
  end

  desc 'TestFlight ic test grubunu kurar (butun derlemeleri otomatik alir) ve App Store Connect kullanicilarini ekler'
  lane :testers do
    api_key
    app = find_app!
    name = 'Ekip'
    group = app.get_beta_groups.find { |g| g.name == name }
    if group
      UI.message("Ic test grubu zaten var: #{name}")
    else
      group = app.create_beta_group(group_name: name, is_internal_group: true, has_access_to_all_builds: true)
      UI.success("Ic test grubu olusturuldu: #{name} (butun derlemeleri otomatik alir)")
    end
    users = Spaceship::ConnectAPI::User.all
    testers = users.map { |u| { email: u.email, firstName: u.first_name.to_s, lastName: u.last_name.to_s, errors: [] } }
    UI.user_error!('App Store Connect kullanici listesi bos geldi') if testers.empty?
    Spaceship::ConnectAPI.post_bulk_beta_tester_assignments(beta_group_id: group.id, beta_testers: testers)
    UI.success("#{testers.size} App Store Connect kullanicisi ic test grubuna eklendi")
  end

  desc '7 dilde magaza metinlerini ve ekran goruntulerini yukler (incelemeye gondermez)'
  lane :metadata do
    key = api_key
    find_app!
    s = settings
    opts = {
      api_key: key, app_identifier: app_id, app_version: version, platform: 'ios',
      metadata_path: File.join(APP_DIR, 'fastlane', 'metadata'),
      screenshots_path: File.join(APP_DIR, 'fastlane', 'screenshots'),
      skip_binary_upload: true, overwrite_screenshots: true, force: true, submit_for_review: false,
      run_precheck_before_submit: false, precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true
    }
    web_url = s['web_url'].to_s.strip.chomp('/')
    if web_url.empty?
      UI.important('store/ayarlar.json icinde web_url yok; gizlilik ve destek adresleri yuklenmedi (incelemeye gondermek icin gerekli).')
    else
      opts[:privacy_url] = LOCALE_TO_LANG.to_h { |loc, lang| [loc, "#{web_url}/privacy.html##{lang}"] }
      opts[:support_url] = LOCALE_TO_LANG.to_h { |loc, lang| [loc, "#{web_url}/support.html##{lang}"] }
      opts[:marketing_url] = LOCALE_TO_LANG.to_h { |loc, lang| [loc, "#{web_url}/##{lang}"] }
    end
    opts[:copyright] = s['copyright'] unless s['copyright'].to_s.strip.empty?
    ensure_review_detail(find_app!)
    review = review_info
    opts[:app_review_information] = review if review
    UI.important('REVIEW_* secret\'lari yok; App Review iletisim bilgilerini App Store Connect\'te elle gir.') unless review
    deliver(opts)
    set_age_rating(find_app!)
  end
end

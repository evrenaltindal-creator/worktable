# CEVRIMDISI MOD (gizlilik) - varsayilan olarak aciktir.
# Acikken hicbir veri bilgisayarinizdan disari cikmaz: bulut saglayicilari
# (Anthropic/OpenAI) ve yerel olmayan adresler engellenir.
# Bulut modellerini bilerek kullanmak isterseniz: OFFLINE_ONLY=false
OFFLINE_ONLY=true

# Asagidaki anahtarlar YALNIZCA OFFLINE_ONLY=false iken kullanilir.
# Varsayilan ekip yerel Ollama modelleriyle calistigi icin bunlar gereksizdir.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

PORT=3000
# 0.0.0.0 yaparsaniz ayni ag/tunel uzerinden baska cihazlardan da erisilebilir.
HOST=0.0.0.0

# Bos birakilirsa kimlik dogrulama yapilmaz (sadece localhost icin uygundur).
# Uygulamayi bir tunel (Cloudflare Tunnel, ngrok, Tailscale Funnel vb.) ile
# disariya aciyorsaniz burada gizli bir deger tanimlayip adrese
# ?token=GIZLI_DEGER parametresiyle erisin.
REMOTE_ACCESS_TOKEN=

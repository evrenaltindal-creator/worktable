# Çini Ustası: App Store işleri
#
# GitHub Actions'ta çalışır (.github/workflows/cini-ustasi-ios.yml). Gizli bilgiler GitHub
# secret'larından ortam değişkeni olarak gelir; hiçbiri depoda durmaz:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8   App Store Connect API anahtarı (Admin rolü)
#   APPLE_TEAM_ID                           Apple Developer ekip kimliği
#   REVIEW_FIRST_NAME, REVIEW_LAST_NAME,    (isteğe bağlı) App Review iletişim bilgileri
#   REVIEW_PHONE, REVIEW_EMAIL
#
# İşler:
#   status    Paket kimliği ve uygulama kaydı var mı, son derleme numarası kaç
#   register  Paket kimliğini (Bundle ID) Apple hesabına kaydeder
#   build_upload  Uygulamayı derler, imzalar ve App Store Connect'e yükler
#   metadata  7 dilde metinleri ve ekran görüntülerini yükler
#   submit    Son derlemeyi incelemeye gönderir

require 'json'
require 'fileutils'
require 'tmpdir'

default_platform(:ios)

APP_DIR  = File.expand_path('..', __dir__)
ROOT_DIR = File.expand_path('..', APP_DIR)
MAGAZA   = File.join(ROOT_DIR, 'magaza')
STORE    = File.join(APP_DIR, 'build', 'store')
LOCALES  = { 'tr' => 'tr', 'en' => 'en-US', 'pt' => 'pt-BR', 'de' => 'de-DE', 'fr' => 'fr-FR', 'ja' => 'ja', 'ko' => 'ko' }.freeze

def settings
  JSON.parse(File.read(File.join(MAGAZA, 'ayarlar.json')))
end

# Paket kimliği: capacitor.config.json'daki appId; yer tutucuysa App Store Connect kaydından
# (magaza/ayarlar.json içindeki apple_id ile) okunur. api_key çağrıldıktan sonra kullanılmalı.
def app_id
  id = JSON.parse(File.read(File.join(APP_DIR, 'capacitor.config.json')))['appId']
  return id unless id.include?('yourcompany')
  apple_id = settings['apple_id'].to_s.strip
  UI.user_error!("capacitor.config.json içindeki appId yer tutucu (#{id}) ve magaza/ayarlar.json'da apple_id yok.") if apple_id.empty?
  @resolved_app_id ||= begin
    app = Spaceship::ConnectAPI::App.get(app_id: apple_id)
    UI.user_error!("Apple ID #{apple_id} ile uygulama bulunamadı.") unless app
    UI.message("Paket kimliği App Store Connect kaydından alındı: #{app.bundle_id}")
    app.bundle_id
  end
end

def placeholder?(value)
  value.to_s.strip.empty? || value.to_s.include?('[')
end

def api_key
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8].each do |k|
    UI.user_error!("GitHub secret eksik: #{k}") if ENV[k].to_s.strip.empty?
  end
  app_store_connect_api_key(
    key_id: ENV['ASC_KEY_ID'].strip,
    issuer_id: ENV['ASC_ISSUER_ID'].strip,
    key_content: ENV['ASC_KEY_P8'],
    duration: 1200,
    in_house: false
  )
end

def review_info
  keys = { first_name: 'REVIEW_FIRST_NAME', last_name: 'REVIEW_LAST_NAME', phone_number: 'REVIEW_PHONE', email_address: 'REVIEW_EMAIL' }
  vals = keys.transform_values { |k| ENV[k].to_s.strip }
  return nil if vals.values.any?(&:empty?)
  vals.merge(demo_user: '', demo_password: '', notes: 'No account or login is needed. The game works fully offline.')
end

# magaza/ klasöründen fastlane'in beklediği metin ve ekran görüntüsü klasörlerini üretir
def prepare_store
  FileUtils.rm_rf(STORE)
  texts = JSON.parse(File.read(File.join(MAGAZA, 'metinler.json')))
  s = settings
  site = placeholder?(s['site_url']) ? '' : s['site_url'].strip.sub(%r{/\z}, '')
  first_version = (s['version'] || '1.0') == '1.0'
  LOCALES.each do |code, locale|
    t = texts.fetch(code)
    dir = File.join(STORE, 'metadata', locale)
    FileUtils.mkdir_p(dir)
    { 'name' => t['name'], 'subtitle' => t['subtitle'], 'promotional_text' => t['promo'],
      'keywords' => t['keywords'], 'description' => t['description'] }.each do |file, value|
      File.write(File.join(dir, "#{file}.txt"), value)
    end
    File.write(File.join(dir, 'release_notes.txt'), t['whatsNew']) unless first_version
    unless site.empty?
      File.write(File.join(dir, 'support_url.txt'), "#{site}/cini-ustasi/")
      File.write(File.join(dir, 'marketing_url.txt'), "#{site}/cini-ustasi/")
      File.write(File.join(dir, 'privacy_url.txt'), "#{site}/cini-ustasi/gizlilik.html")
    end
    shots = File.join(STORE, 'screenshots', locale)
    FileUtils.mkdir_p(shots)
    Dir[File.join(MAGAZA, 'ekran-goruntuleri', code, '*.png')].sort.each { |f| FileUtils.cp(f, shots) }
  end
  UI.important('magaza/ayarlar.json içinde site_url yok; destek ve gizlilik adresleri yüklenmedi.') if site.empty?
end

platform :ios do
  desc 'Paket kimliği ve uygulama kaydının durumunu yazar'
  lane :status do
    api_key
    id = app_id
    UI.message("Paket kimliği #{id}: #{Spaceship::ConnectAPI::BundleId.find(id) ? 'kayıtlı' : 'kayıtlı değil'}")
    app = Spaceship::ConnectAPI::App.find(id)
    if app
      UI.success("Uygulama kaydı var: #{app.name} (Apple ID #{app.id}, ana dil #{app.primary_locale})")
      begin
        v = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
        UI.message(v ? "Düzenlenebilir sürüm: #{v.version_string} (#{v.app_store_state})" : 'Düzenlenebilir sürüm yok')
      rescue StandardError => e
        UI.message("Sürüm bilgisi okunamadı (#{e.message})")
      end
      begin
        UI.message("TestFlight'taki son derleme: #{latest_testflight_build_number(app_identifier: id)}")
      rescue StandardError => e
        UI.message("Henüz derleme yok (#{e.message})")
      end
    else
      UI.important("App Store Connect'te bu kimlikle uygulama kaydı yok. Yeni uygulama web arayüzünden oluşturulmalı.")
    end
  end

  desc 'Mağaza sayfasını dil dil raporlar: metinler, ekran görüntüleri, adresler, kategori'
  lane :check do
    api_key
    app = Spaceship::ConnectAPI::App.find(app_id)
    UI.user_error!('Uygulama kaydı bulunamadı') unless app
    v = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!('Düzenlenebilir sürüm yok') unless v
    UI.message("Sürüm #{v.version_string}: #{v.app_store_state}, telif: #{v.copyright || '-'}")
    begin
      b = v.get_build
      UI.message("Seçili derleme: #{b ? b.version : 'yok'}")
    rescue StandardError => e
      UI.message("Derleme bilgisi okunamadı (#{e.message})")
    end
    v.get_app_store_version_localizations.sort_by(&:locale).each do |loc|
      shots = begin
        loc.get_app_screenshot_sets.map do |set|
          states = set.app_screenshots.to_a.map { |a| (a.asset_delivery_state || {})['state'] }
          "#{set.screenshot_display_type} #{states.size} adet (#{states.tally.map { |k, n| "#{k}: #{n}" }.join(', ')})"
        end.join(' | ')
      rescue StandardError => e
        "okunamadı (#{e.message})"
      end
      UI.message("#{loc.locale}: açıklama #{loc.description.to_s.length} kr, anahtar kelime #{loc.keywords.to_s.length} kr, " \
                 "tanıtım #{loc.promotional_text.to_s.length} kr, destek URL #{loc.support_url || '-'}; görseller: #{shots.empty? ? 'yok' : shots}")
    end
    info = app.fetch_edit_app_info
    if info
      info.get_app_info_localizations.sort_by(&:locale).each do |l|
        UI.message("#{l.locale}: ad '#{l.name}', alt başlık '#{l.subtitle}', gizlilik URL #{l.privacy_policy_url || '-'}")
      end
      cat = [info.primary_category, info.primary_subcategory_one, info.primary_subcategory_two].map { |c| c ? c.id : '-' }
      UI.message("Kategori: #{cat.join(' / ')}")
      begin
        age = info.fetch_age_rating_declaration
        filled = age ? (age.instance_variables - [:@id, :@reverse_attr_map]).map { |iv| age.instance_variable_get(iv) }.compact.size : 0
        UI.message("Yaş derecelendirmesi: #{age ? "#{filled} soru yanıtlanmış" : 'yanıtlanmamış'}")
      rescue StandardError => e
        UI.message("Yaş derecelendirmesi okunamadı (#{e.message})")
      end
    end
  end

  desc 'Paket kimliğini (Bundle ID) Apple hesabına kaydeder'
  lane :register do
    api_key
    id = app_id
    if Spaceship::ConnectAPI::BundleId.find(id)
      UI.success("Paket kimliği zaten kayıtlı: #{id}")
    else
      Spaceship::ConnectAPI::BundleId.create(name: 'Cini Ustasi', platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS, identifier: id)
      UI.success("Paket kimliği kaydedildi: #{id}")
    end
    status
  end

  desc 'Uygulamayı derler, imzalar ve App Store Connect\'e yükler'
  lane :build_upload do
    api_key
    id = app_id
    UI.user_error!('GitHub secret eksik: APPLE_TEAM_ID') if ENV['APPLE_TEAM_ID'].to_s.strip.empty?
    latest = begin
      latest_testflight_build_number(app_identifier: id, initial_build_number: 0)
    rescue StandardError => e
      UI.important("Son derleme numarası okunamadı (#{e.message}); 1 ile başlıyorum.")
      0
    end
    build = latest.to_i + 1
    UI.message("Derleme numarası: #{build}")
    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID'].strip}.p8")
    File.write(key_path, ENV['ASC_KEY_P8'])
    sh(File.join(APP_DIR, 'scripts', 'ios-release.sh'), id, build.to_s, key_path)
  end

  desc '7 dilde metinleri ve ekran görüntülerini yükler'
  lane :metadata do
    key = api_key
    id = app_id
    prepare_store
    s = settings
    opts = {
      api_key: key, app_identifier: id, app_version: s['version'] || '1.0',
      metadata_path: File.join(STORE, 'metadata'), screenshots_path: File.join(STORE, 'screenshots'),
      skip_binary_upload: true, overwrite_screenshots: true, force: true, submit_for_review: false,
      skip_screenshots: ENV['SKIP_SCREENSHOTS'] == '1', screenshot_processing_timeout: 600,
      run_precheck_before_submit: false, precheck_include_in_app_purchases: false,
      primary_category: 'GAMES', primary_first_sub_category: 'GAMES_PUZZLE', primary_second_sub_category: 'GAMES_CASUAL'
    }
    opts[:copyright] = s['copyright'] unless placeholder?(s['copyright'])
    review = review_info
    opts[:app_review_information] = review if review
    deliver(opts)
  end

  desc 'Apple tarafında işlenmesi takılan ekran görüntülerini bulup yeniden yükler, sırayı korur'
  lane :fix_shots do
    api_key
    app = Spaceship::ConnectAPI::App.find(app_id)
    v = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    fixed = 0
    v.get_app_store_version_localizations.each do |loc|
      code = LOCALES.key(loc.locale)
      next unless code
      loc.get_app_screenshot_sets.each do |set|
        stuck = set.app_screenshots.to_a.reject { |a| (a.asset_delivery_state || {})['state'] == 'COMPLETE' }
        next if stuck.empty?
        stuck.each do |a|
          file = File.join(MAGAZA, 'ekran-goruntuleri', code, a.file_name.to_s)
          UI.user_error!("Yerel dosya yok: #{file}") unless File.exist?(file)
          UI.message("#{loc.locale}: #{a.file_name} (#{(a.asset_delivery_state || {})['state']}) yeniden yükleniyor")
          a.delete!
          set.upload_screenshot(path: file, wait_for_processing: false)
          fixed += 1
        end
        fresh = Spaceship::ConnectAPI::AppScreenshotSet.get(app_screenshot_set_id: set.id)
        ids = fresh.app_screenshots.to_a.sort_by { |a| a.file_name.to_s }.map(&:id)
        fresh.reorder_screenshots(app_screenshot_ids: ids)
      end
    end
    UI.success(fixed.zero? ? 'Takılan ekran görüntüsü yok' : "#{fixed} ekran görüntüsü yeniden yüklendi")
  end

  desc 'Yalnızca metinleri ve adresleri günceller (ekran görüntülerine dokunmaz)'
  lane :text do
    ENV['SKIP_SCREENSHOTS'] = '1'
    metadata
  end

  desc 'Son derlemeyi incelemeye gönderir'
  lane :submit do
    key = api_key
    deliver(
      api_key: key, app_identifier: app_id, app_version: settings['version'] || '1.0',
      skip_metadata: true, skip_screenshots: true, skip_binary_upload: true,
      submit_for_review: true, automatic_release: false, force: true, run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
